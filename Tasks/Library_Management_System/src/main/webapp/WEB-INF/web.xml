		<servlet-class>com.lib.controller.CreateBookServlet</servlet-class>
	</servlet>

	<servlet-mapping>
		<servlet-name>CreateBookServlet</servlet-name>
		<url-pattern>/addBook</url-pattern>
	</servlet-mapping>

